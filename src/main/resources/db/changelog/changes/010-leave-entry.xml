<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="010-leave-entry" author="xyzsoft">
        <createTable tableName="LEAVE_ENTRY">
            <column name="ID"            type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="RESOURCE_ID"   type="VARCHAR(50)"><constraints nullable="false"/></column>
            <column name="RESOURCE_NAME" type="VARCHAR(100)"/>
            <column name="LEAVE_DATE"    type="DATE"><constraints nullable="false"/></column>
            <column name="LEAVE_TYPE"    type="VARCHAR(50)"/>
            <column name="STATUS"        type="VARCHAR(20)" defaultValue="APPROVED"/>
            <column name="SOURCE"        type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="REASON"        type="VARCHAR(500)"/>
            <column name="CREATED_BY"    type="VARCHAR(100)"/>
            <column name="CREATED_AT"    type="TIMESTAMP"/>
        </createTable>

        <addUniqueConstraint tableName="LEAVE_ENTRY"
                             columnNames="RESOURCE_ID, LEAVE_DATE, SOURCE"
                             constraintName="UQ_LEAVE_RES_DATE_SRC"/>

        <createIndex tableName="LEAVE_ENTRY" indexName="IDX_LEAVE_DATE">
            <column name="LEAVE_DATE"/>
        </createIndex>
        <createIndex tableName="LEAVE_ENTRY" indexName="IDX_LEAVE_RES_DATE">
            <column name="RESOURCE_ID"/>
            <column name="LEAVE_DATE"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
